# Copy to .env and adjust values
POSTGRES_USER=alss
POSTGRES_PASSWORD=alss_password
POSTGRES_DB=alss_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Optional: Gemini AI for insights (backend)
# Set GEMINI_API_KEY to enable AI explanations; leave empty to use fallback summaries.
GEMINI_API_KEY=
# Optional override (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash
